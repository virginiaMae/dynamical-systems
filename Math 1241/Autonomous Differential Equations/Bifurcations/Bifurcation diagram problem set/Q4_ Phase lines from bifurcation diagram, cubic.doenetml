<module copy="doenet:83TXioRLQfjiFmpyoM1xhD" aspectRatio="6" vmin="$xmin" vmax="$xmax" var="$x" nEquilibria="3" E1="$parval2_root1" E1stable="true" E2="$parval2_root2" E2stable="false" E3="$parval2_root3" E3stable="true" />

</exercise>



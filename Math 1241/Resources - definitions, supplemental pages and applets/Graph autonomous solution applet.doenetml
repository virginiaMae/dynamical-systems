<module name="graphicalAutonomousSolution"><setup><number copy="$Pystart.value" name="ref1" /><number copy="$Pxstart.value" name="ref2" /><number copy="$Pystart.value" name="ref3" /><number copy="$Pystart.value" name="ref4" /><number copy="$Pxstart.value" name="ref5" /><number copy="$Pystart.value" name="ref6" /><number copy="$Pystart.value" name="ref7" /><number copy="$Pxstart.value" name="ref8" /><number copy="$Pystart.value" name="ref9" /><number copy="$Pystart.value" name="ref10" /><number copy="$Pxstart.value" name="ref11" /><number copy="$Pystart.value" name="ref12" /><number copy="$Pystart.value" name="ref13" /><number copy="$Pxstart.value" name="ref14" /><number copy="$Pystart.value" name="ref15" /><number copy="$Pystart.value" name="ref16" /><number copy="$Pxstart.value" name="ref17" /><number copy="$Pystart.value" name="ref18" /><number copy="$Pystart.value" name="ref19" /><number copy="$Pxstart.value" name="ref20" /><number copy="$Pystart.value" name="ref21" /><number copy="$Pystart.value" name="ref22" /><number copy="$Pxstart.value" name="ref23" /><number copy="$Pystart.value" name="ref24" /></setup>
  <moduleAttributes><text name="size">medium</text><_componentSize name="height">300px</_componentSize><number name="aspectRatio">1</number><number name="vmin">-10</number><number name="vmax">10</number><number name="dv">0.5</number><math name="ICexpr">$(var)_0</math><boolean name="fixAxes">true</boolean><math name="var">x</math><text name="grid">medium</text><boolean name="convertEquilibria">false</boolean><number name="minHandleRadius">1</number><number name="numPoints">8</number><number name="IC1">-7</number><number name="final1">-Infinity</number><number name="IC2">-6</number><number name="final2">-6</number><number name="IC3">-5</number><number name="final3">-1</number><number name="IC4">-1</number><number name="final4">-1</number><number name="IC5">4</number><number name="final5">-1</number><number name="IC6">5</number><number name="final6">5</number><number name="IC7">6</number><number name="final7">Infinity</number><number name="IC8">8</number><number name="final8">Infinity</number><boolean name="Estable1">true</boolean><boolean name="Estable2">true</boolean><boolean name="Estable3">true</boolean><boolean name="Estable4">true</boolean><boolean name="Estable5">true</boolean><boolean name="Estable6">true</boolean><boolean name="Estable7">true</boolean><boolean name="Estable8">true</boolean></moduleAttributes>

  
<setup>
  <boolean name="showSolution1">false</boolean>
  <boolean name="showSolution2">false</boolean>
  <boolean name="showSolution3">false</boolean>
  <boolean name="showSolution4">false</boolean>
  <boolean name="showSolution5">false</boolean>
  <boolean name="showSolution6">false</boolean>
  <boolean name="showSolution7">false</boolean>
  <boolean name="showSolution8">false</boolean>
  <number name="zeroFixed" fixed="true">0</number>
  <number name="vrange" fixed="true">$vmax-$vmin</number>
  <boolean name="convertE1">$convertEquilibria and $ansSol1.creditAchieved = 1 and $IC1 = $final1</boolean>
  <boolean name="convertE2">$convertEquilibria and $ansSol2.creditAchieved = 1 and $IC2 = $final2</boolean>
  <boolean name="convertE3">$convertEquilibria and $ansSol3.creditAchieved = 1 and $IC3 = $final3</boolean>
  <boolean name="convertE4">$convertEquilibria and $ansSol4.creditAchieved = 1 and $IC4 = $final4</boolean>
  <boolean name="convertE5">$convertEquilibria and $ansSol5.creditAchieved = 1 and $IC5 = $final5</boolean>
  <boolean name="convertE6">$convertEquilibria and $ansSol6.creditAchieved = 1 and $IC6 = $final6</boolean>
  <boolean name="convertE7">$convertEquilibria and $ansSol7creditAchieved = 1 and $IC7 = $final7</boolean>
  <boolean name="convertE8">$convertEquilibria and $ansSol8creditAchieved'}) = 1 and $IC8 = $final8</boolean>
</setup>
<!-- 
<graph width='$width' height='$height' ymin='$vmin' ymax='$vmax' xmin="&#x2D;0.1$vrange" xmax="0.9*$vrange" fixAxes="$fixAxes" identicalAxisScales grid="$grid" > -->


<graph size="$size" aspectRatio="$aspectRatio" ymin="$vmin" ymax="$vmax" xmin="-0.1$vrange" xmax="0.9*$vrange" fixAxes="$fixAxes" grid="$grid">
  <xLabel><m>t</m></xLabel>
  <yLabel><m>$var</m></yLabel>

  <conditionalContent condition="$showSolution1">
    <setup>
      <number fixed="true" name="r11">max(0.5 abs($p12y-$p11y),$minHandleRadius)</number>
      <number fixed="true" name="r12">max(0.3 abs($p12x), $minHandleRadius)</number>
      <math extend="$P11.y" name="p11y" />
      <number name="p11m">$P11handle.y/$P11handle.x</number>
      <boolean name="p11r">$P11handle.x &lt; 0</boolean>
      <math extend="$P12.y" name="p12y" />
      <math extend="$P12.x" name="p12x" />
      <boolean name="p12r">$P12handle.x &lt; 0</boolean>
      <number name="p12m">$P12handle.y/$P12handle.x</number>
      <integer extend="$C1.numXCriticalPoints" name="nXcpC1" />
      <integer extend="$C1.numYCriticalPoints" name="nYcpC1" />
      <text extend="$C1.extrapolateForwardMode" name="efmC1" />
      <integer extend="$C1.numCurvatureChangePoints" name="nccpC1" />

      <number fixed="true" name="Pystart">$vmin+0.6$vrange</number>
      <number fixed="true" name="Pxstart">0.6$vrange</number>
    </setup>
        
    <point name="P11" styleNumber="1" x="$zeroFixed" y="$ref1" hide="$ansSol1.creditAchieved =1" labelPosition="upperleft">
      <label><m>$var=$P11.y</m></label>
      
        <constrainToGrid dy="$dv" />
        <constrainToGraph />
      
    </point>
    <point name="P11handle" x="-1" y="-1" hide="true">
      
        <constrainTo><circle radius="$r11" /></constrainTo>
        <attractTo threshold="0.01*$vrange"><line>y=0</line></attractTo>
      
    </point>
    <point name="P12" styleNumber="1" x="$ref2" y="$ref3" hide="$ansSol1.creditAchieved=1">
      
        <constrainTo><regionHalfPlane boundaryValue="0.8*$vrange" greaterThan="false" /></constrainTo>
        <attractToGrid dx="10*$vrange" dy="$dv" ythreshold="$dv" xthreshold="0.001$vrange" includeGridlines="true" />
        <constrainToGraph />
      
    </point>
    <point name="P12handle" x="-1" y="-1" hide="true">
      
        <constrainTo><circle radius="$r12" /></constrainTo>
        <attractTo threshold="0.01*$vrange"><line>y=0</line></attractTo>
      
    </point>
    <curve name="C1" through="$P11 $P12" extrapolateForward="true" draggable="$ansSol1.creditAchieved&lt; 1" styleNumber="1" hide="$convertE1">
      <bezierControls alwaysVisible="true">
        <controlVectors><vector>$P11handle</vector></controlVectors>
        <controlVectors><vector>$P12handle</vector></controlVectors>
      </bezierControls>
    </curve>
    <conditionalContent condition="$convertE1">
      <equilibriumLine styleNumber="9" switchable="$ansE1.creditAchieved&lt;1" draggable="false" name="E1">y=$IC1</equilibriumLine>
    </conditionalContent>

  </conditionalContent>
  


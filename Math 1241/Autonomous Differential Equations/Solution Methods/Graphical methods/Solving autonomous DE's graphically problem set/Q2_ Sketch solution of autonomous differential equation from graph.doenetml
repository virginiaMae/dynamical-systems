    <curve through="$P61 $P62" extrapolateForward="true" draggable="$ansSol456.creditAchieved&lt; 1" name="C6" styleNumber="3" layer="2">
      <bezierControls alwaysVisible="true">
        <controlVectors><vector>$P61disp</vector></controlVectors>

<problem>

<setup>
  <selectFromSequence name="a" exclude="0" numToSelect="2" withReplacement="true" from="-10" to="10" excludecombinations="(1 1) (1 -1) (-1 1) (-1 -1)" />
  <select name="x">x y z</select>

  <math name="factored_quadratic" simplify="full">($x+$a[1])($x+$a[2])</math>
  <math name="expanded_quadratic" simplify="full" expand="true">$factored_quadratic</math>

</setup>

Factor the quadratic <m>$expanded_quadratic</m>.

<p>Answer <mathInput name="ans" /></p>

<answer name="check">
  <award><when>
    <hasSameFactoring>
      <mathInput isResponse="true" extend="$ans" />
      $factored_quadratic
    </hasSameFactoring>
  </when></award>
</answer>

<solution>
  The factored quadratic is <m>$factored_quadratic</m>.
</solution>

</problem>
  
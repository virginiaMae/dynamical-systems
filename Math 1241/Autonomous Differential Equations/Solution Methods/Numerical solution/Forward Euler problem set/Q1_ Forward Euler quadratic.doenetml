<m> \cdot</m> 
<mathInput name="deltat8" />
<answer>
  <award symbolicEquality="true" simplifyOnCompare="true" allowedErrorInNumbers="0.001" referencesAreResponses="$zhalf_3 $f_of_zhalf $deltat8" matchPartial="true">

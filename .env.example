# Copy this file to .env and fill in a fresh Doenet session cookie.
#
# How to get it:
#   1. Log into doenet.org in your browser.
#   2. Open DevTools -> Application (Chrome) / Storage (Firefox) -> Cookies.
#   3. Copy the value of the "connect.sid" cookie (starts with "s%3A...").
#
# This expires/rotates periodically -- if pull or push fails with a "notMe"
# or auth-looking error, refresh it here.

DOENET_SESSION_COOKIE=

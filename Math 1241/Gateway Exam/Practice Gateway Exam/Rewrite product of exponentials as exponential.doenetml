<problem>
<selectFromSequence name="a0" hide="true" from="1" to="100" />
<selectFromSequence name="t0" hide="true" from="1" to="4" />
<select name="recip" hide="true">
  <option>
    <number>0</number>
    <math format="latex" simplify="none">
      $a0 \cdot $extra_factor $b0^{t - $t0 }
    </math>
    <group>
      <md>
        <mrow>$f(t)\amp = <math simplify="numbersPreserveOrder" format="latex">$a0 \cdot  $extra_factor $b0^{ t - $t0 }</math></mrow>
        <mrow>\amp = <math simplify="numbersPreserveOrder" format="latex">$a0 \cdot $extra_factor $b0^{ t}  $b0^{ -$t0 }</math></mrow>
        <mrow>\amp = \left($a0 \cdot $b0^{ -$t0 }\right) $b0_with_extra^t</mrow>
        <mrow>\amp = \frac{ $a0 }{ $b0^{ $t0 } }$b0_with_extra^t</mrow>
      </md>
      Therefore, <m>a = $a</m> and <m>b=$b</m>.
    </group>
  </option>
  <option>
    <number>1</number>
    <math format="latex" simplify="none">
      \frac{ $a0 }{ $extra_factor $b0^{ t - $t0 } }
    </math>
    <group>
      <md>
        <mrow>$f(t)\amp = <math simplify="numbersPreserveOrder" format="latex">\frac{ $a0 }{ $extra_factor $b0^{ t - $t0 } }</math></mrow>
        <mrow>\amp = <math simplify="numbersPreserveOrder" format="latex">$a0 \cdot  $extra_factor_recip$b0^{ -(t-$t0) }</math></mrow>
        <mrow>\amp = <math simplify="numbersPreserveOrder" format="latex">$a0 \cdot  $extra_factor_recip $b0^{ -t+$t0 }</math></mrow>
        <mrow>\amp = $a0 \cdot$b0_with_extra^{ -t} \cdot $b0^{ $t0 }</mrow>
        <mrow>\amp = \left($a0 \cdot $b0^{ $t0 }\right) \left(\frac{1}{$b0_with_extra }\right)^t.</mrow>
      </md>
      Therefore <m>a = $a0 \cdot $b0^{ $t0 } = $a</m> and <m>b= \frac{1}{$b0_with_extra }</m>.
    </group>
  </option>
</select>

<selectFromSequence name="b0" hide="true" from="2" to="8" />
<selectFromSequence name="twofactors" hide="true" from="0" to="1" />
<selectFromSequence name="c0" hide="true" from="2" to="5" />
<select name="f" hide="true">f g h k y z u v w Q R S U V W</select>
<math name="recip_exp" hide="true" simplify="full">1-2*<number extend="$recip[1][1]" /></math>
<math name="a" hide="true" simplify="full"><selectFromSequence extend="$a0" />*<selectFromSequence extend="$b0" />^(-<math extend="$recip_exp" />*<selectFromSequence extend="$t0" />)</math>
<math name="extra_factor" hide="true" simplify="full">(<selectFromSequence extend="$c0" />^<selectFromSequence extend="$twofactors" />)^t</math>
<math name="extra_factor_recip" hide="true" simplify="full">(<selectFromSequence extend="$c0" />^<selectFromSequence extend="$twofactors" />)^(-t)</math>
<math name="b0_with_extra" hide="true" simplify="full"><selectFromSequence extend="$b0" />*<selectFromSequence extend="$c0" />^<selectFromSequence extend="$twofactors" /></math>
<math name="b" hide="true" simplify="full"><math extend="$b0_with_extra" />^(<math extend="$recip_exp" />)</math>


Rewrite the exponential function
<me><select extend="$f" />(t) = <math simplify="numbersPreserveOrder" format="latex"> 
<math extend="$recip[1][2]" />
</math></me> 
in the form <m><select extend="$f" />(t)=ab^t</m>, where we call <m>a</m> the <q>initial value</q> (the value when <m>t=0</m>) and <m>b</m> the <q>growth factor.</q>  In this form:
<p><m>a =</m> <mathInput name="input1" /></p>
<p><m>b =</m> <mathInput name="input2" /></p>

<answer>
  <award matchpartial="true" referencesAreResponses="$input1 $input2"><when> 
  <mathList>$input1 $input2</mathList>
  =
  <mathList>$a $b</mathList>
  </when> </award>
</answer>

<solution>
<group name="sol" extend="$recip[1][3]" />
</solution>
</problem>

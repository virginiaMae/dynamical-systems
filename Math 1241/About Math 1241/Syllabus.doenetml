    <cell>Course total</cell>
    <cell />
    <cell />
    <cell halign="right"><number>$totalWrittenExams+$totalComputerExams+$totalFinalExams+$totalQuizes+$totalProblemSets+$totalProjects+$totalParticipation</number></cell>
</row>

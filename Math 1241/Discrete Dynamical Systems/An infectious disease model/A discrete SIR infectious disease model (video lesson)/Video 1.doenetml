    <case condition="$v1.fractionWatched > 0.9">1</case>
    <else>$v1.fractionWatched</else>
  </conditionalContent>
</number>
  
  <p>Video credit achieved: <number displayDecimals="1">$v1RoundUp*100</number>%</p>


          <circle radius="1.5" />
        </constrainTo>
        <attractTo><point>(1.5,0)</point></attractTo>
      
    </point>
    <vector name="vector8" tail="$vector8Tail" displacement="$vector8Disp" styleNumber="1" fixed="$ansSolVec789.creditAchieved=1" layer="2" />
    <point name="vector9Tail" x="$zeroFixed" y="-2" styleNumber="1" hide="$ansSolVec789.creditAchieved=1">
      
        <attractTo threshold="0.8"><point>(0, $a)</point></attractTo>
        <attractTo threshold="0.8"><point>(0, $b)</point></attractTo>
        <attractTo threshold="0.8"><point>(0, $c)</point></attractTo>
      
    </point>

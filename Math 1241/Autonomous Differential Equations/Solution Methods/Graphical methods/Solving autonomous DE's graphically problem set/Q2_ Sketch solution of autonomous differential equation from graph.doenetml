  <conditionalContent condition="$showShadowVecs">
    <repeatForSequence from="3" to="27" step="3" valueName="t">
        <vector tail="($t, $copy)" displacement="$vector1Disp" styleNumber="9" fixed="true" />
        <vector tail="($t, $v2ty)" displacement="$vector2Disp" styleNumber="9" fixed="true" />
        <vector tail="($t, $v3ty)" displacement="$vector3Disp" styleNumber="9" fixed="true" />
        <vector tail="($t, $v4ty)" displacement="$vector4Disp" styleNumber="9" fixed="true" />
        <vector tail="($t, $copy1)" displacement="$vector5Disp" styleNumber="9" fixed="true" />
        <vector tail="($t, $copy2)" displacement="$vector6Disp" styleNumber="9" fixed="true" />
        <vector tail="($t, $a)" displacement="(1.5,0)" styleNumber="9" fixed="true" />
        <vector tail="($t, $b)" displacement="(1.5,0)" styleNumber="9" fixed="true" />
        <vector tail="($t, $c)" displacement="(1.5,0)" styleNumber="9" fixed="true" />
      </repeatForSequence>

  </conditionalContent>


  <conditionalContent condition="$showSolution1">
    <setup>
      <math extend="$P11.y" name="p11y" />
      <number name="p11m">$P11disp.y/$P11disp.x</number>
      <math extend="$P12.y" name="p12y" />
      <math extend="$P12.x" name="p12x" />
      <boolean name="p12r">$P12disp.x &lt; 0</boolean>
      <math extend="$P12disp.y" name="p12dy" />
    </setup>
    <point name="P11" x="$zeroFixed" y="4" hide="$ansSol1.creditAchieved = 1" styleNumber="2" layer="2">
      
        <attractTo threshold="0.5"><point>(0, 2)</point></attractTo>
      
    </point>
    <point name="P11disp" x="-1" y="-1" hide="true">
      
        <constrainTo><regionHalfPlane boundaryValue="-0.01" greaterThan="false" /></constrainTo>
        <constrainTo><circle /></constrainTo>
      
    </point>
      <point name="P12" x="10" y="1" hide="$ansSol1.creditAchieved = 1" styleNumber="2" layer="2">
      
        <constrainTo><regionHalfPlane boundaryValue="5" /></constrainTo>
        <constrainTo><regionHalfPlane boundaryValue="20" greaterThan="false" /></constrainTo>
        <attractTo><line>y=$a</line></attractTo>
      
    </point>
    <point name="P12disp" x="-1" y="-1" hide="true">
      
        <constrainTo><regionHalfPlane boundaryValue="-0.01" greaterThan="false" /></constrainTo>
        <constrainTo><circle radius="0.7$P12.x" /></constrainTo>
        <attractTo><line>y=0</line></attractTo>
      
    </point>

    <curve name="C1" through="$P11 $P12" extrapolateForward="true" draggable="$ansSol1.creditAchieved&lt; 1" styleNumber="2" layer="2">
      <bezierControls alwaysVisible="true">
        <controlVectors><vector>
          (0.5 <math fixed="true" extend="$P12.x" /> $P11disp.x,
          0.5 <math fixed="true" extend="$P12.x" /> $P11disp.y)
        </vector></controlVectors>
        <controlVectors><vector>$P12disp</vector></controlVectors>
      </bezierControls>
    </curve>
    
  </conditionalContent>

  <conditionalContent condition="$animation1On and $ansSol1.creditAchieved = 1">
    <setup>
      <number name="t1">0</number>
      <animateFromSequence target="$t1" animationMode="increase" from="0" to="25" step="0.2" animationOn="$animation1On" animationInterval="50" />
      <number name="midP1s">0.4*$p12x</number>
      <number name="midP1sSlope">2*(-8-2)/$p12x</number>
      <number name="t1Eff" displayDecimals="1">$PAn1.x</number>
      <number name="ut1Eff" displayDecimals="1">$PAn1.y</number>
    </setup>
    <point name="PAn1" styleNumber="5" x="$t1" y="max(min($midP1sSlope*($t1-$midP1s),2),-8)" fixed="true" layer="3">
      <label><m>w($t1Eff) = $ut1Eff</m></label>
   
      
        <constrainTo>$C1</constrainTo>
      
    </point>
  </conditionalContent>
    


  <conditionalContent condition="$showSolution2">

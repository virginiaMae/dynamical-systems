<answer matchPartial="true">
<award allowedErrorInNumbers="0.01" referencesAreResponses="$micp3 $mifcp3">
  <when>
    $micp3 = $cp3 and
    $mifcp3 = $f_cp3
  </when>
</award>
</answer>
</p>

  
<p>(Enter in same order as above.  If rounding, keep at least 3 significant digits.)</p>
</exercise>


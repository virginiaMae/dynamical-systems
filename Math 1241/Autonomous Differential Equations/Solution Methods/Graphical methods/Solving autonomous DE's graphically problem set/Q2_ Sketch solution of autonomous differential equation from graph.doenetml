      <animateFromSequence target="$t3" animationMode="increase" from="0" to="25" step="0.2" animationOn="$animation3On" animationInterval="50" />
      <number name="midP3sSlope">2*($c-10)/$p32x</number>
      <number name="t3Eff" displayDecimals="1">$PAn3.x</number>
      <number name="ut3Eff" displayDecimals="1">$PAn3.y</number>
    </setup>
    <point name="PAn3" styleNumber="5" x="$t3" y="max($midP3sSlope*$t3,$c)" fixed="true" layer="3">
      <label><m>w($t3Eff) = $ut3Eff</m></label>
      
        <constrainTo>$C3</constrainTo>
      
    </point>
  </conditionalContent>
    

  <conditionalContent condition="$showSolution456">
    <setup>
      <math extend="$P41.y" name="p41y" />
      <math extend="$P51.y" name="p51y" />
      <math extend="$P61.y" name="p61y" />
      <number name="p41m">$P41disp.y/$P41disp.x</number>
      <number name="p51m">$P51disp.y/$P51disp.x</number>
      <number name="p61m">$P61disp.y/$P61disp.x</number>
      <math extend="$P42.y" name="p42y" />
      <math extend="$P52.y" name="p52y" />
      <math extend="$P62.y" name="p62y" />
      <math extend="$P42disp.y" name="p42dy" />
      <math extend="$P52disp.y" name="p52dy" />
      <math extend="$P62disp.y" name="p62dy" />
    </setup>
    <point name="P41" x="$zeroFixed" y="-2" hide="$ansSol456.creditAchieved = 1" styleNumber="3" layer="2">
      
        <attractTo><point>(0, $a)</point></attractTo>
        <attractTo><point>(0, $b)</point></attractTo>
        <attractTo><point>(0, $c)</point></attractTo>
      
    </point>
    <point name="P51" x="$zeroFixed" y="2" hide="$ansSol456.creditAchieved = 1" styleNumber="3" layer="2">
      
        <attractTo><point>(0, $a)</point></attractTo>
        <attractTo><point>(0, $b)</point></attractTo>
        <attractTo><point>(0, $c)</point></attractTo>
      
    </point>
    <point name="P61" x="$zeroFixed" y="4" hide="$ansSol456.creditAchieved = 1" styleNumber="3" layer="2">
      
        <attractTo><point>(0, $a)</point></attractTo>
        <attractTo><point>(0, $b)</point></attractTo>
        <attractTo><point>(0, $c)</point></attractTo>
      
    </point>
    <point name="P41disp" x="-1" y="-1" hide="true">
      
        <constrainTo><regionHalfPlane boundaryValue="-0.01" greaterThan="false" /></constrainTo>
        <constrainTo><circle radius="2" /></constrainTo>
        <attractTo><line>y=0</line></attractTo>
      
    </point>
    <point name="P51disp" x="-1" y="1" hide="true">
      
        <constrainTo><regionHalfPlane boundaryValue="-0.01" greaterThan="false" /></constrainTo>
        <constrainTo><circle radius="2" /></constrainTo>
        <attractTo><line>y=0</line></attractTo>
      
    </point>
    <point name="P61disp" x="-1" y="1" hide="true">
      
        <constrainTo><regionHalfPlane boundaryValue="-0.01" greaterThan="false" /></constrainTo>
        <constrainTo><circle radius="2" /></constrainTo>
        <attractTo><line>y=0</line></attractTo>
      
    </point>
    <point name="P42" x="10" y="-1" hide="$ansSol456.creditAchieved = 1" styleNumber="3" layer="2">
      
        <constrainTo><regionHalfPlane boundaryValue="5" /></constrainTo>
        <constrainTo><regionHalfPlane boundaryValue="20" greaterThan="false" /></constrainTo>
        <attractTo><line>y=$a</line></attractTo>
        <attractTo><line>y=$b</line></attractTo>
        <attractTo><line>y=$c</line></attractTo>
      
    </point>
    <point name="P52" x="10" y="1" hide="$ansSol456.creditAchieved = 1" styleNumber="3" layer="2">
      
        <constrainTo><regionHalfPlane boundaryValue="5" /></constrainTo>
        <constrainTo><regionHalfPlane boundaryValue="20" greaterThan="false" /></constrainTo>
        <attractTo><line>y=$a</line></attractTo>
        <attractTo><line>y=$b</line></attractTo>
        <attractTo><line>y=$c</line></attractTo>
      

<title>Simulation of a discrete SIR infectious disease model</title>

<setup>
  <function name="fSIR" variables="S I R">(S - $b S I, I + $b S I - $a I, R + $a I)</function>
  <math name="initial">($S0, $I0, $R0)</math>
  <number name="zeroFixed" fixed="true">0</number>
  <functionIterates function="$fSIR" initialValue="$initial" numIterates="$nIterates" name="iteration" />

  <!-- <map>
    <template>$i</template>
    <sources alias="x" indexAlias="i"><copy prop="iterates" source="iteration" /></sources>
  </map> -->


  <!-- <map>
    <template><point x="$i" y="$i" /></template>
    <sources alias="x" indexAlias="i"><copy prop="iterates" source="iteration" /></sources>
  </map> -->


  <!-- <map>
    <template><point x="$i" y="$(x{prop='x'})"/></template>
    <sources alias="x" indexAlias="i"><copy prop="iterates" source="iteration" /></sources>
  </map> -->

  <!-- <copy prop="iterates" source="iteration" /> -->

  <!-- <map name="SPoints">
    <template><point x="$i" y="$(x{prop='x'})"/></template>
    <sources alias="x" indexAlias="i"><copy prop="iterates" source="iteration" /></sources>
  </map>
  <map name="IPoints">
    <template><point x="$i" y="$(x{prop='y'})"/></template>
    <sources alias="x" indexAlias="i"><copy prop="iterates" source="iteration" /></sources>
  </map>
  <map name="RPoints">
    <template><point x="$i" y="$Ntot&#x2D;$(x{prop='x'})&#x2D;$(x{prop='y'})"/></template>
    <sources alias="x" indexAlias="i"><copy prop="iterates" source="iteration" /></sources>
  </map> -->
  <clampNumber name="S0" lowerValue="0" upperValue="Infinity">9990</clampNumber>
  <clampNumber name="I0" lowerValue="0" upperValue="Infinity">10</clampNumber>
  <clampNumber name="R0" lowerValue="0" upperValue="Infinity">0</clampNumber>
</setup>



<p>The below applet is a simulation of the <ref to="TBD">discrete SIR infectious disease model</ref>
<md>
  <mrow>S_{t+1} - S_t\amp = -$b S_t I_t</mrow>
  <mrow>I_{t+1} - I_t\amp = $b S_tI_t - $a I_t</mrow>
  <mrow>R_{t+1} - R_t\amp = $a I_t.</mrow>
</md>
where</p>
<ul>
  <li><m>S_t</m> = the number of susceptibles in day <m>t</m></li>
  <li><m>I_t</m> = the number of infectives in day <m>t</m></li>
  <li><m>R_t</m> = the number of removed in day <m>t</m>.</li>
</ul>

<p>Initial conditions:</p>
  <ul>
<li><m>S_0 =</m> <mathInput bindValueTo="$S0" /></li>
<li><m>I_0 =</m> <mathInput bindValueTo="$I0" /></li>
<li><m>R_0 =</m> <mathInput bindValueTo="$R0" /></li>
</ul>
<p>Total population size: <m>N_{tot} = <math simplify="true" name="Ntot">$S0+$I0+$R0</math> </m></p>



<graph xmin="$xmin" xmax="$xmax" ymin="$ymin" ymax="$ymax" name="plot">
  <discreteSimulationResultPolyline allIterates="$iteration.allIteratesWithInitial" seriesNumber="1" draggable="false" />
  <discreteSimulationResultPolyline allIterates="$iteration.allIteratesWithInitial" seriesNumber="2" draggable="false" styleNumber="2" />
  <discreteSimulationResultPolyline allIterates="$iteration.allIteratesWithInitial" seriesNumber="3" draggable="false" styleNumber="3" />
  <point x="$zeroFixed" y="$S0" layer="1">
    
      <constrainToGrid dy="1" />
    
  </point>
  <point x="$zeroFixed" y="$I0" styleNumber="2" layer="1">
    
      <constrainToGrid dy="1" />
    
  </point>
  <point x="$zeroFixed" y="$R0" styleNumber="3">
    
      <constrainToGrid dy="1" />
    
  </point>
  <legend>
    <label>Susceptibles <m>S_t</m></label>
    <label>Infectives <m>I_t</m></label>
    <label>Removed <m>R_t</m></label>
  </legend>
</graph>

<aside>
<title>Values at each time</title>

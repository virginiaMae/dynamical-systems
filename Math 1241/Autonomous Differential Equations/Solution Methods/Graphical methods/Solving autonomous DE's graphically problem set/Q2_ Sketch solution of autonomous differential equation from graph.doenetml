    <curve through="$P31 $P32" extrapolateForward="true" draggable="$ansSol3.creditAchieved&lt; 1" name="C3" styleNumber="2" layer="2">
      <bezierControls alwaysVisible="true">
        <controlVectors><vector>$P31disp</vector></controlVectors>
        <controlVectors><vector>$P32disp</vector></controlVectors>

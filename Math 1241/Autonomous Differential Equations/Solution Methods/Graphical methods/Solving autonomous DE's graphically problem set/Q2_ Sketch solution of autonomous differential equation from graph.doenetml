    </setup>
    <point name="PAn2" styleNumber="5" x="$t2" y="min($midP2sSlope*$t2 + 4,$c)" fixed="true" layer="3">
      <label><m>w($t2Eff) = $ut2Eff</m></label>
      
        <constrainTo>$C2</constrainTo>
      
    </point>
  </conditionalContent>
    
 

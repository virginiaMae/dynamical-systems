Doenet-Sync-ID: 7YFsQ2zRQL6LNBcALQt3jv
Doenet-Sync-Version: 0.7.28
Doenet-Sync-NumVariants: 1
Doenet-Sync-Hash: 22bfac9c5b161f9b
-->
<problem>
<!-- <title>Sketch solution of autonomous differential equation from graph</title> -->

<setup>

<number name="a">-8</number>
<number name="b">3</number>
<number name="c">7</number>
<number name="ab1" displayDecimals="1">(2*$a+$b)/3</number>
<number name="ab2" displayDecimals="1">($a+2*$b)/3</number>
1-\frac{6.25}{9}
<function name="fun" variables="w" styleNumber="10">-exp(-w ^2/50)(w -$a )*(w -$b )*(w -$c )/100</function>
<number name="wmin">-11</number>
<number name="wmax">11</number>
<number name="zeroFixed" fixed="true">0</number>


  <styleDefinition styleNumber="2" markerStyle="circle" markerSize="3" />
  <styleDefinition styleNumber="4" markerColor="lightgreen" markerSize="6" />
  <styleDefinition styleNumber="5" markerColor="magenta" markerSize="4" />
  <styleDefinition styleNumber="6" lineColor="cyan" markerColor="cyan" lineWidth="2" lineStyle="solid" />
  <styleDefinition styleNumber="7" markerColor="cyan" markerSize="0" markerStyle="circle" />
  <styleDefinition styleNumber="8" lineColor="brown" lineWidth="2" markerColor="brown" />
  <styleDefinition styleNumber="9" lineColor="lightgray" lineWidth="2" />
  <styleDefinition styleNumber="10" lineColor="purple" lineWidth="2" />


</setup>

<p>Consider the dynamical system
<md>
  <mrow>\frac{ dw }{ dt }\amp = f(w )</mrow>
  <mrow>w (0)\amp = w_0,</mrow>
</md>
where the function <m>f</m> is graphed in the top panel, below, and <m>w _0</m> is an initial condition.  (The zeros of <m>f</m> are <m>$a </m>, <m>$b </m>, and <m>$c </m>.)</p>

<section><title>Sketch direction vectors on state line</title>

<p>In the top panel, the horizontal axis is the <m>w</m>-axis or state line.  The first step is to plot vectors along the state line indicating how <m>w(t)</m> changes </p>

<p>Click <updateValue name="revealVector1" type="boolean" target="$showVector1" newValue="true" disabled="$showVector1">
  <label>show vector</label>
</updateValue> and plot a vector in the interval where <m>w &lt; $a</m>.
  <answer disabled="not $showVector1" name="ansVec1">
    <award matchPartial="true">
      <when>
        <boolean name="v1OnAxis">$fw.v1ty = 0 and $fw.v1hy=0</boolean>
        and
        <boolean name="v1Location">$v1OnAxis and $fw.v1hx &lt; $a and $fw.v1tx &lt; $a</boolean>
        and
        <boolean name="v1Right">$v1Location and $fw.v1hx > $fw.v1tx + 1</boolean>
      </when>
    </award>
    <considerAsResponses>
      $fw.v1tx $fw.v1ty $fw.v1hx $fw.v1hy
    </considerAsResponses>
  </answer>
</p>
<feedback updateWith="$ansVec1" condition="not $v1OnAxis">
  The vector must be on the <m>w</m>-axis.
</feedback>
<feedback updateWith="$ansVec1" condition="$v1OnAxis and not $v1Location">
  The vector must be in the interval where <m>w &lt; $a</m>.
</feedback>
<feedback updateWith="$ansVec1" condition="$v1Location and $fw.v1hx &lt;= $fw.v1tx">
  The vector is not pointing in the right direction.
</feedback>
<feedback updateWith="$ansVec1" condition="$v1Location and $fw.v1tx &lt; $fw.v1hx &lt; $fw.v1tx+1">
  Make the vector a little longer.
</feedback>
  

<p>Click <updateValue name="revealVectors234" type="boolean" target="$showVector234" newValue="true" disabled="$showVector234">
  <label>show three vectors</label>
</updateValue> and plot three vectors in the interval where <m>$a &lt; w &lt; $b</m>.
  <answer disabled="not $showVector234" name="ansVec234">
    <award matchPartial="true">
      <when>
        <boolean name="v2sOnAxis">$fw.v2Aty = 0 and $fw.v2Ahy=0 and $fw.v2Bty = 0 and $fw.v2Bhy=0 and $fw.v2Cty = 0 and $fw.v2Chy=0</boolean>
        and
        <boolean name="v2sLocation">$v2sOnAxis and min($fw.v2Ahx, $fw.v2Atx, $fw.v2Bhx, $fw.v2Btx, $fw.v2Chx, $fw.v2Ctx) > $a and max($fw.v2Ahx, $fw.v2Atx, $fw.v2Bhx, $fw.v2Btx, $fw.v2Chx, $fw.v2Ctx) &lt; $b</boolean>
        and
        <boolean name="v2sRightDirection">$v2sLocation and $fw.v2Ahx &lt; $fw.v2Atx and $fw.v2Bhx &lt; $fw.v2Btx and $fw.v2Chx &lt; $fw.v2Ctx</boolean>
        and
        <boolean name="v2BLocation">$v2sRightDirection and $fw.v2Bhx &lt; ($a+$b)/2 &lt; $fw.v2Btx</boolean>
        and
        <boolean name="v2sNotOverlap">$v2BLocation and $fw.v2Atx &lt; $fw.v2Bhx and $fw.v2Btx &lt; $fw.v2Chx</boolean>
        and
        <boolean name="v2sOuterLongEnough">$v2sNotOverlap and $fw.v2Atx - $fw.v2Ahx > 1 and $fw.v2Ctx - $fw.v2Chx > 1</boolean>
        and
        <boolean name="v2BLongEnough">$v2sOuterLongEnough and $fw.v2Btx - $fw.v2Bhx > 1.5 max($fw.v2Atx - $fw.v2Ahx, $fw.v2Ctx - $fw.v2Chx)</boolean>
      </when>
    </award>
    <considerAsResponses>
      $fw.v2tx $fw.v2ty $fw.v2hx $fw.v2hy
      $fw.v3tx $fw.v3ty $fw.v3hx $fw.v3hy
      $fw.v4tx $fw.v4ty $fw.v4hx $fw.v4hy
    </considerAsResponses>
  </answer>
</p>
<feedback updateWith="$ansVec234" condition="not $v2sOnAxis">
  All vectors must be on the <m>w</m>-axis.
</feedback>
<feedback updateWith="$ansVec234" condition="$v2sOnAxis and not $v2sLocation">
  All vectors must be in the interval where <m>$a &lt; w &lt; $b</m>.
</feedback>
<feedback updateWith="$ansVec234" condition="$v2sLocation and not $v2sRightDirection">
  All vector must point in right direction.
</feedback>
<feedback updateWith="$ansVec234" condition="$v2sRightDirection and not $v2BLocation">
  The middle vector should be in the middle of the interval <m>$a &lt; w &lt; $b</m> (where the velocity is largest).
</feedback>
<feedback updateWith="$ansVec234" condition="$v2BLocation and not $v2sNotOverlap">
  The vectors must be separated from each other.
</feedback>
<feedback updateWith="$ansVec234" condition="$v2sNotOverlap and not $v2sOuterLongEnough">
  Make the outer vectors a little longer.
</feedback>
<feedback updateWith="$ansVec234" condition="$v2sOuterLongEnough and not $v2BLongEnough">
  The middle vector should be significantly longer than the outer vectors.
</feedback>


<p>Click <updateValue name="revealVector5" type="boolean" target="$showVector5" newValue="true" disabled="$showVector5">
  <label>show vector</label>
</updateValue> and plot a vector in the interval where <m>$b &lt; w &lt; $c</m>.
  <answer disabled="not $showVector5" name="ansVec5">
    <award matchPartial="true">
      <when>
        <boolean name="v5OnAxis">$fw.v5ty = 0 and $fw.v5hy=0</boolean>
        and
        <boolean name="v5Location">$v5OnAxis and min($fw.v5hx, $fw.v5tx) > $b and max($fw.v5hx, $fw.v5tx) &lt; $c</boolean>
        and
        <boolean name="v5Right">$v5Location and $fw.v5hx > $fw.v5tx + 1</boolean>
      </when>
    </award>
    <considerAsResponses>
      $fw.v5tx $fw.v5ty $fw.v5hx $fw.v5hy
    </considerAsResponses>
  </answer>
</p>
<feedback updateWith="$ansVec5" condition="not $v5OnAxis">
  The vector must be on the <m>w</m>-axis.
</feedback>
<feedback updateWith="$ansVec5" condition="$v5OnAxis and not $v5Location">
  The vector must be in the interval where <m>$b &lt; w &lt; $c</m>.
</feedback>
<feedback updateWith="$ansVec5" condition="$v5Location and $fw.v5hx &lt;= $fw.v5tx">
  The vector is not pointing in the right direction.
</feedback>
<feedback updateWith="$ansVec5" condition="$v5Location and $fw.v5tx &lt; $fw.v5hx &lt; $fw.v5tx+1">
  Make the vector a little longer.
</feedback>
  

<p>Click <updateValue name="revealVector6" type="boolean" target="$showVector6" newValue="true" disabled="$showVector6">
  <label>show vector</label>
</updateValue> and plot a vector in the interval where <m>w > $c</m>.
  <answer disabled="not $showVector6" name="ansVec6">
    <award matchPartial="true">
      <when>
        <boolean name="v6OnAxis">$fw.v6ty = 0 and $fw.v6hy=0</boolean>
        and
        <boolean name="v6Location">$v6OnAxis and min($fw.v6hx, $fw.v6tx) > $c</boolean>
        and
        <boolean name="v6Right">$v6Location and $fw.v6tx > $fw.v6hx + 1</boolean>
      </when>
    </award>
    <considerAsResponses>
      $fw.v6tx $fw.v6ty $fw.v6hx $fw.v6hy
    </considerAsResponses>
  </answer>
</p>
<feedback updateWith="$ansVec6" condition="not $v6OnAxis">
  The vector must be on the <m>w</m>-axis.
</feedback>
<feedback updateWith="$ansVec6" condition="$v6OnAxis and not $v6Location">
  The vector must be in the interval where <m>$w > $c</m>.
</feedback>
<feedback updateWith="$ansVec6" condition="$v6Location and $fw.v6tx &lt;= $fw.v6hx">
  The vector is not pointing in the right direction.
</feedback>
<feedback updateWith="$ansVec6" condition="$v6Location and $fw.v6hx &lt; $fw.v6tx &lt; $fw.v6hx+1">
  Make the vector a little longer.
</feedback>
  

<p>Click <updateValue name="revealEquilibria" type="boolean" target="$showEquilibria" newValue="true" disabled="$showEquilibria">
  <label>show points</label> 
</updateValue> move the points to the equilibria.
<answer name="ansEquil" disabled="not $showEquilibria">
  <award referencesAreResponses="$fw.E1 $fw.E2 $fw.E3" matchPartial="true">
    <when>
      <mathList>$fw.E1 $fw.E2 $fw.E3</mathList> = 
      <mathList unordered="true"><math>($a,0)</math><math>($b,0)</math><math>($c,0)</math></mathList>
    </when>
  </award>
</answer>
</p>

</section>



<setup>
  <boolean name="showVector1">false</boolean>
  <boolean name="showVector234">false</boolean>
  <boolean name="showVector5">false</boolean>
  <boolean name="showVector6">false</boolean>
  <boolean name="showEquilibria">false</boolean>
</setup>

<p>Show test point: <booleanInput name="showTestPoint" /></p>
<graph aspectRatio="2" xmin="$wmin" xmax="$wmax" ymin="-3.2" ymax="1.2" fixAxes="true" name="fw" size="large">
  <xLabel><m>w</m></xLabel>
  $fun
  
  <line name="xAxis" fixed="true" styleNumber="8">y=0</line>

  <conditionalContent condition="$showTestPoint">
    <point name="TP" x="1" y="$zeroFixed" styleNumber="6" showCoordsWhenDragging="false" layer="3">
      <label><m>w = $TPx</m></label>
    </point>
    <setup>
      <math extend="$TP.x" name="TPx" displayDigits="3" />
      <evaluate function="$fun" input="$TPx" name="fTPx" displayDigits="3" />
    </setup>
    <point name="TPtop" x="$TPx" y="$fTPx" styleNumber="7" layer="3">
      <label><m>f(w)=$fTPx</m></label>
    </point>
    <lineSegment endpoints="$TP ($TPx, $fTPx)" styleNumber="6" showCoordsWhenDragging="false" layer="3" />

    <vector tail="$TP" displacement="($fTPx, 0)" styleNumber="6" fixed="true" layer="3" />
  </conditionalContent>

  <conditionalContent condition="$showVector1">
    <setup>
      <copy prop="x" source="vector1Tail" name="v1tx" />
      <copy prop="y" source="vector1Tail" name="v1ty" />
      <math extend="$vector1Head.x" name="v1hx" />
      <math extend="$vector1Head.y" name="v1hy" />
    </setup>
    <point name="vector1Tail" x="-10" y="-1.5" hide="$ansVec1.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <point name="vector1Head" x="-8" y="-1.5" hide="$ansVec1.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <vector name="vector1" tail="$vector1Tail" head="$vector1Head" styleNumber="1" layer="2" fixed="$ansVec1.creditAchieved = 1" />
  </conditionalContent>


  <conditionalContent condition="$showVector234">
    <setup>
      <sort sortVectorsBy="tail" name="v2A">
        $vector2$vector3$vector4
      </sort>
      <copy prop="tailX1" source="v2A[1]" name="v2Atx" />
      <copy prop="tailX2" source="v2A[1]" name="v2Aty" />
      <copy prop="headX1" source="v2A[1]" name="v2Ahx" />
      <copy prop="headX2" source="v2A[1]" name="v2Ahy" />
      <copy prop="tailX1" source="v2A[2]" name="v2Btx" />
      <copy prop="tailX2" source="v2A[2]" name="v2Bty" />
      <copy prop="headX1" source="v2A[2]" name="v2Bhx" />
      <copy prop="headX2" source="v2A[2]" name="v2Bhy" />
      <copy prop="tailX1" source="v2A[3]" name="v2Ctx" />
      <copy prop="tailX2" source="v2A[3]" name="v2Cty" />
      <copy prop="headX1" source="v2A[3]" name="v2Chx" />
      <copy prop="headX2" source="v2A[3]" name="v2Chy" />
    </setup>
    <point name="vector2Tail" x="-4" y="-1.5" hide="$ansVec234.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <point name="vector2Head" x="-2" y="-1.5" hide="$ansVec234.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <vector name="vector2" tail="$vector2Tail" head="$vector2Head" styleNumber="1" layer="2" fixed="$ansVec234.creditAchieved = 1" />


    <point name="vector3Tail" x="-4" y="-2" hide="$ansVec234.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <point name="vector3Head" x="-2" y="-2" hide="$ansVec234.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <vector name="vector3" tail="$vector3Tail" head="$vector3Head" styleNumber="1" layer="2" fixed="$ansVec234.creditAchieved = 1" />

    <point name="vector4Tail" x="-4" y="-1" hide="$ansVec234.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <point name="vector4Head" x="-2" y="-1" hide="$ansVec234.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <vector name="vector4" tail="$vector4Tail" head="$vector4Head" styleNumber="1" layer="2" fixed="$ansVec234.creditAchieved = 1" />
  </conditionalContent>

  <conditionalContent condition="$showVector5">
    <setup>
      <copy prop="x" source="vector5Tail" name="v5tx" />
      <copy prop="y" source="vector5Tail" name="v5ty" />
      <math extend="$vector5Head.x" name="v5hx" />
      <math extend="$vector5Head.y" name="v5hy" />
    </setup>
    <point name="vector5Tail" x="4" y="-1.5" hide="$ansVec5.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <point name="vector5Head" x="6" y="-1.5" hide="$ansVec5.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <vector name="vector5" tail="$vector5Tail" head="$vector5Head" styleNumber="1" layer="2" fixed="$ansVec5.creditAchieved = 1" />
  </conditionalContent>


  <conditionalContent condition="$showVector6">
    <setup>
      <copy prop="x" source="vector6Tail" name="v6tx" />
      <copy prop="y" source="vector6Tail" name="v6ty" />
      <math extend="$vector6Head.x" name="v6hx" />
      <math extend="$vector6Head.y" name="v6hy" />
    </setup>
    <point name="vector6Tail" x="8" y="-1.5" hide="$ansVec6.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <point name="vector6Head" x="10" y="-1.5" hide="$ansVec6.creditAchieved = 1">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
      
    </point>
    <vector name="vector6" tail="$vector6Tail" head="$vector6Head" styleNumber="1" layer="2" fixed="$ansVec6.creditAchieved = 1" />
  </conditionalContent>


  <conditionalContent condition="$showEquilibria">
    <point name="E1" x="-4" y="-1.5" fixed="$ansEquil.creditAchieved = 1" styleNumber="3">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
        <attractTo threshold="0.4"><point>($a,0)</point></attractTo>
        <attractTo threshold="0.4"><point>($b,0)</point></attractTo>
        <attractTo threshold="0.4"><point>($c,0)</point></attractTo>
      
    </point>
    <point name="E2" x="-1" y="-1.5" fixed="$ansEquil.creditAchieved = 1" styleNumber="3">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
        <attractTo threshold="0.4"><point>($a,0)</point></attractTo>
        <attractTo threshold="0.4"><point>($b,0)</point></attractTo>
        <attractTo threshold="0.4"><point>($c,0)</point></attractTo>
      
    </point>
    <point name="E3" x="4" y="-1.5" fixed="$ansEquil.creditAchieved = 1" styleNumber="3">
      
        <attractTo threshold="0.2">$xAxis</attractTo>
        <attractTo threshold="0.4"><point>($a,0)</point></attractTo>
        <attractTo threshold="0.4"><point>($b,0)</point></attractTo>
        <attractTo threshold="0.4"><point>($c,0)</point></attractTo>
      
    </point>
  </conditionalContent>

  <conditionalContent condition="$animation1On and $ansSol1.creditAchieved = 1">
    <point styleNumber="5" x="$wt.ut1Eff" y="0" fixed="true">
      <label><m>w($wt.t1Eff) = $wt.ut1Eff</m></label>
    </point>
  </conditionalContent>
   
  <conditionalContent condition="$animation2On and $ansSol2.creditAchieved = 1">
    <point styleNumber="5" x="$wt.ut2Eff" y="0" fixed="true">
      <label><m>w($wt.t2Eff) = $wt.ut2Eff</m></label>
    </point>
  </conditionalContent>
      
  <conditionalContent condition="$animation3On and $ansSol3.creditAchieved = 1">
    <point styleNumber="5" x="$wt.ut3Eff" y="0" fixed="true">
      <label><m>w($wt.t3Eff) = $wt.ut3Eff</m></label>
    </point>
  </conditionalContent>
   

</graph>
  




<setup>
  <boolean name="showSolVecs1">false</boolean>
  <boolean name="showSolVecs2">false</boolean>
  <boolean name="showSolVecs3">false</boolean>
  <boolean name="showSolVecs4">false</boolean>
  <boolean name="showSolVecs5">false</boolean>
  <boolean name="showSolVecs6">false</boolean>
  <boolean name="showSolVecs789">false</boolean>
  <boolean name="showShadowVecs">false</boolean>
  <boolean name="showSolution1">false</boolean>
  <boolean name="showSolution2">false</boolean>
  <boolean name="showSolution3">false</boolean>
  <boolean name="showSolution456">false</boolean>
  <boolean name="animation1On">true</boolean>
  <boolean name="animation2On">true</boolean>
  <boolean name="animation3On">true</boolean>
  
</setup>

<graph aspectRatio="50/35" xmin="-2" xmax="18" ymin="$wmin" ymax="$wmax" fixAxes="true" name="wt" identicalAxisScales="true" size="large">
  <yLabel><m>w</m></yLabel>
  <xLabel><m>t</m></xLabel>

  <line name="yAxis" styleNumber="8" hide="v$ansUAxis2.creditAchieved &lt; 1" fixed="true">x=0</line>

  <point name="u02" stylenumber="4" fixed="true" hide="$ansU0s.creditAchieved&lt;1">(0,$u01)</point>

  <conditionalContent condition="$showTestPoint">
    <point name="TPt" x="0" y="$fw.TPx" styleNumber="6" showCoordsWhenDragging="false" layer="3" labelPosition="lowerleft">
      <label><m>w = $fw.TPx</m></label>
    </point>
    <setup>
      <math extend="$TPt.x" name="TPtx" />
      <number name="theta">arctan($fw.fTPx)</number>
      <number name="dx">1.5*cos($theta)</number>
      <number name="dy">1.5*sin($theta)</number>
    </setup>
    <vector tail="$TPt" displacement="($dx, $dy)" styleNumber="6" fixed="true" layer="3">
      <label>slope=$fw.fTPx</label>
    </vector>
  </conditionalContent>

  <conditionalContent condition="$showSolVecs1">
    <setup>
      <copy prop="y" source="vector1Tail" name="copy" />
      <boolean name="v1r">$vector1Disp.x > 0</boolean>
      <number name="v1m">$vector1Disp.y/$vector1Disp.x</number>
    </setup>
    <point name="vector1Tail" x="$zeroFixed" y="1" styleNumber="1" hide="$ansSolVec1.creditAchieved=1">
      
        <attractTo threshold="1.1"><lineSegment endpoints="(0, -11) (0, $a-1)" /></attractTo>
      
    </point>
    <point name="vector1Disp" x="1" y="0" hide="true">
      
        <constrainTo>
          <circle radius="1.5" />
        </constrainTo>
      
    </point>
    <vector name="vector1" tail="$vector1Tail" displacement="$vector1Disp" styleNumber="1" fixed="$ansSolVec1.creditAchieved=1" />
  </conditionalContent>

  <conditionalContent condition="$showSolVecs2">
    <setup>
      <copy prop="y" source="vector2Tail" name="v2ty" />
      <boolean name="v2r">$vector2Disp.x > 0</boolean>
      <number name="v2m">$vector2Disp.y/$vector2Disp.x</number>
    </setup>
    <point name="vector2Tail" x="$zeroFixed" y="1" styleNumber="1" hide="$ansSolVec2.creditAchieved=1">
      
        <attractTo threshold="1.1"><lineSegment endpoints="(0, $a+1) (0, $ab1-0.5)" /></attractTo>
      
    </point>
    <point name="vector2Disp" x="1" y="0" hide="true">
      
        <constrainTo>
          <circle radius="1.5" />
        </constrainTo>
      
    </point>
    <vector name="vector2" tail="$vector2Tail" displacement="$vector2Disp" styleNumber="1" fixed="$ansSolVec2.creditAchieved=1" />
  </conditionalContent>

  <conditionalContent condition="$showSolVecs3">
    <setup>
      <copy prop="y" source="vector3Tail" name="v3ty" />
      <boolean name="v3r">$vector3Disp.x > 0</boolean>
      <number name="v3m">$vector3Disp.y/$vector3Disp.x</number>
    </setup>
    <point name="vector3Tail" x="$zeroFixed" y="1" styleNumber="1" hide="$ansSolVec3.creditAchieved=1">
      
        <attractTo threshold="1.1"><lineSegment endpoints="(0, $ab1+0.5) (0, $ab2-0.5)" /></attractTo>
      
    </point>
    <point name="vector3Disp" x="1" y="0" hide="true">
      
        <constrainTo>
          <circle radius="1.5" />
        </constrainTo>
      
    </point>
    <vector name="vector3" tail="$vector3Tail" displacement="$vector3Disp" styleNumber="1" fixed="$ansSolVec3.creditAchieved=1" />
  </conditionalContent>

  <conditionalContent condition="$showSolVecs4">
    <setup>
      <copy prop="y" source="vector4Tail" name="v4ty" />
      <boolean name="v4r">$vector4Disp.x > 0</boolean>
      <number name="v4m">$vector4Disp.y/$vector4Disp.x</number>
    </setup>
    <point name="vector4Tail" x="$zeroFixed" y="1" styleNumber="1" hide="$ansSolVec4.creditAchieved=1">
      
        <attractTo threshold="1.1"><lineSegment endpoints="(0, $ab2+0.5) (0, $b-0.5)" /></attractTo>
      
    </point>
    <point name="vector4Disp" x="1" y="0" hide="true">
      
        <constrainTo>
          <circle radius="1.5" />
        </constrainTo>
      
    </point>
    <vector name="vector4" tail="$vector4Tail" displacement="$vector4Disp" styleNumber="1" fixed="$ansSolVec4.creditAchieved=1" />
  </conditionalContent>

    
  <conditionalContent condition="$showSolVecs5">
    <setup>
      <copy prop="y" source="vector5Tail" name="copy1" />
      <boolean name="v5r">$vector5Disp.x > 0</boolean>
      <number name="v5m">$vector5Disp.y/$vector5Disp.x</number>
    </setup>
    <point name="vector5Tail" x="$zeroFixed" y="1" styleNumber="1" hide="$ansSolVec5.creditAchieved=1">
      
        <attractTo threshold="1.1"><lineSegment endpoints="(0, $b+0.5) (0, $c-1)" /></attractTo>
      
    </point>
    <point name="vector5Disp" x="1" y="0" hide="true">
      
        <constrainTo>
          <circle radius="1.5" />
        </constrainTo>
      
    </point>
    <vector name="vector5" tail="$vector5Tail" displacement="$vector5Disp" styleNumber="1" fixed="$ansSolVec5.creditAchieved=1" />
  </conditionalContent>

        
  <conditionalContent condition="$showSolVecs6">
    <setup>
      <copy prop="y" source="vector6Tail" name="copy2" />
      <boolean name="v6r">$vector6Disp.x > 0</boolean>
      <number name="v6m">$vector6Disp.y/$vector6Disp.x</number>
    </setup>
    <point name="vector6Tail" x="$zeroFixed" y="1" styleNumber="1" hide="$ansSolVec6.creditAchieved=1">
      
        <attractTo threshold="1.1"><lineSegment endpoints="(0, $c+1) (0, 11)" /></attractTo>
      
    </point>
    <point name="vector6Disp" x="1" y="0" hide="true">
      
        <constrainTo>
          <circle radius="1.5" />
        </constrainTo>
      
    </point>
    <vector name="vector6" tail="$vector6Tail" displacement="$vector6Disp" styleNumber="1" fixed="$ansSolVec6.creditAchieved=1" />
  </conditionalContent>


  <conditionalContent condition="$showSolVecs789">
    <setup>
      <math extend="$vector7Tail.y" name="v7ty" />
      <boolean name="v7r">$vector7Disp.x > 0</boolean>
      <number name="v7m">$vector7Disp.y/$vector7Disp.x</number>
      <math extend="$vector8Tail.y" name="v8ty" />
      <boolean name="v8r">$vector8Disp.x > 0</boolean>
      <number name="v8m">$vector8Disp.y/$vector8Disp.x</number>
      <math extend="$vector9Tail.y" name="v9ty" />
      <boolean name="v9r">$vector9Disp.x > 0</boolean>
      <number name="v9m">$vector9Disp.y/$vector9Disp.x</number>
    </setup>
    <point name="vector7Tail" x="$zeroFixed" y="4" styleNumber="1" hide="$ansSolVec789.creditAchieved=1">
      
        <attractTo threshold="0.8"><point>(0, $a)</point></attractTo>
        <attractTo threshold="0.8"><point>(0, $b)</point></attractTo>
        <attractTo threshold="0.8"><point>(0, $c)</point></attractTo>
      
    </point>
    <point name="vector7Disp" x="1" y="0" hide="true">
      
        <constrainTo>
          <circle radius="1.5" />
        </constrainTo>
        <attractTo><point>(1.5,0)</point></attractTo>
      
    </point>
    <vector name="vector7" tail="$vector7Tail" displacement="$vector7Disp" styleNumber="1" fixed="$ansSolVec789.creditAchieved=1" />
    <point name="vector8Tail" x="$zeroFixed" y="1" styleNumber="1" hide="$ansSolVec789.creditAchieved=1">
      
        <attractTo threshold="0.8"><point>(0, $a)</point></attractTo>
        <attractTo threshold="0.8"><point>(0, $b)</point></attractTo>
        <attractTo threshold="0.8"><point>(0, $c)</point></attractTo>
      
    </point>
    <point name="vector8Disp" x="1" y="0" hide="true">
      

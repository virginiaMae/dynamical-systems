      <number fixed="true" name="r81">max(0.5 abs($p82y-$p81y),$minHandleRadius)</number>
      <number fixed="true" name="r82">max(0.3 abs($p82x), $minHandleRadius)</number>
      <math extend="$P81.y" name="p81y" />
      <number name="p81m">$P81handle.y/$P81handle.x</number>
      <boolean name="p81r">$P81handle.x &lt; 0</boolean>
      <math extend="$P82.y" name="p82y" />
      <math extend="$P82.x" name="p82x" />
      <boolean name="p82r">$P82handle.x &lt; 0</boolean>
      <number name="p82m">$P82handle.y/$P82handle.x</number>
      <integer extend="$C8.numXCriticalPoints" name="nXcpC8" />
      <integer extend="$C8.numYCriticalPoints" name="nYcpC8" />
      <text extend="$C8.extrapolateForwardMode" name="efmC8" />
      <integer extend="$C8.numCurvatureChangePoints" name="nccpC8" />
    </setup>

    <point name="P81" styleNumber="8" x="$zeroFixed" y="$ref22" hide="$ansSol8.creditAchieved=1" labelPosition="upperleft">
      <label><m>$var=$P81.y</m></label>
      
        <constrainToGrid dy="$dv" />
        <constrainToGraph />
      
    </point>
    <point name="P81handle" x="-1" y="-1" hide="true">
      
        <constrainTo><circle radius="$r81" /></constrainTo>
        <attractTo threshold="0.01*$vrange"><line>y=0</line></attractTo>
      
    </point>
    <point name="P82" styleNumber="8" x="$ref23" y="$ref24" hide="$ansSol8.creditAchieved=1">
      
        <constrainTo><regionHalfPlane boundaryValue="0.8*$vrange" greaterThan="false" /></constrainTo>
        <attractToGrid dx="10*$vrange" dy="$dv" ythreshold="$dv" xthreshold="0.001$vrange" includeGridlines="true" />
        <constrainToGraph />
      
    </point>
    <point name="P82handle" x="-1" y="-1" hide="true">
      
        <constrainTo><circle radius="$r82" /></constrainTo>
        <attractTo threshold="0.01*$vrange"><line>y=0</line></attractTo>
      
    </point>
    <curve name="C8" through="$P81 $P82" extrapolateForward="true" draggable="$ansSol8.creditAchieved&lt; 1" styleNumber="8" hide="$convertE8">
      <bezierControls alwaysVisible="true">
        <controlVectors><vector>$P81handle</vector></controlVectors>
        <controlVectors><vector>$P82handle</vector></controlVectors>
      </bezierControls>
    </curve>
    <conditionalContent condition="$convertE8">
      <equilibriumLine styleNumber="9" switchable="$ansE8.creditAchieved&lt;1" draggable="false" name="E8">y=$IC8</equilibriumLine>
    </conditionalContent>

  </conditionalContent>
  


</graph>





<ul>

<li>
  <p>Click <updateValue name="revealSolution1" type="boolean" target="$showSolution1" newValue="true" disabled="$showSolution1">
    <label>show curve</label>
  </updateValue> and use the curve to draw the solution for <m>$ICexpr=$IC1</m>.
  <answer name="ansSol1" matchPartial="true" disabled="not $showSolution1">
    <award>
      <when>
        <boolean name="p11Location">$p11y = $IC1</boolean>
        and
        <boolean name="p11Slope">$p11Location and $p11r and 
          <conditionalContent>
            <case condition="$IC1 > $final1">
              $p11m &lt; 0
            </case>
            <case condition="$IC1 &lt; $final1">
              $p11m > 0
            </case>
            <else>
              $p11m = 0
            </else>
          </conditionalContent>
        </boolean>
        and
        <boolean>$p11Slope and $nXcpC1=0</boolean>
        and
        <conditionalContent>
          <case condition="$final1 = -Infinity">
            <boolean name="c1Decreasing">$p11r and $p11m &lt; 0 and $nYcpC1 = 0</boolean>
            and
            <boolean name="p12DecreasingLocationSlope">$p12r and $p12m &lt; $p11m and $p12y &lt; $p11y and $nYcpC1 = 0 and $efmC1 = parabolaVertical and $nccpC1 = 0</boolean>
          </case>
          <case condition="$final1 = Infinity">
            <boolean name="c1Increasing">$p11r and $p11m > 0 and $nYcpC1 = 0</boolean>
            and
            <boolean name="p12IncreasingLocationSlope">$p12r and $p12m > $p11m and $p12y > $p11y and $nYcpC1 = 0 and $efmC1 = parabolaVertical and $nccpC1 = 0</boolean>
          </case>
          <else>
            <boolean name="p12ConvergeLocationSlope">$p12r and $p12m = 0 and $p12y = $final1</boolean>
          </else>
        </conditionalContent>
      </when>
    </award>

  </answer>
  </p>

  <feedback updateWith="$ansSol1" condition="not $p11Location">
    The initial condition is incorrect.
  </feedback>
  <feedback updateWith="$ansSol1" condition="$nXcpC1 > 0">
    The solution must be a function.  The curve cannot turn around so that time decreases.
  </feedback>
  <feedback updateWith="$ansSol1" condition="$p11Location and not $p11Slope">
      The initial slope is incorrect.
    </feedback>
  <conditionalContent>
    <case condition="$final1 = -Infinity">
      <feedback updateWith="$ansSol1" condition="$p11Slope and not $c1Decreasing">
        The solution does not have the correct behavior for large <m>t</m>.
      </feedback>
      <feedback updateWith="$ansSol1" condition="$p11Slope and $c1Decreasing and not $p12DecreasingLocationSlope">
        The solution must be continually accelerating, i.e., increasing its downward speed so that the curve is concave downward everywhere.  (It can be a little tricky.  Look at the slope line coming from the initial point and make sure the curve keeps bending downward away from that line.)
      </feedback>
    </case>
    <case condition="$final1 = Infinity">
      <feedback updateWith="$ansSol1" condition="$p11Slope and not $c1Increasing">
        The solution does not have the correct behavior for large <m>t</m>.
      </feedback>
      <feedback updateWith="$ansSol1" condition="$p11Slope and $c1Increasing and not $p12IncreasingLocationSlope">
        The solution must be continually accelerating, i.e., increasing its upward speed so that the curve is concave upward everywhere.  (It can be a little tricky.  Look at the slope line coming from the initial point and make sure the curve keeps bending upward away from that line.)
      </feedback>
    </case>
    <else>
      <feedback updateWith="$ansSol1" condition="$p11Slope and not $p12ConvergeLocationSlope">
        The solution does not have the correct behavior for large <m>t</m>.
      </feedback>
    </else>
  </conditionalContent>

  <conditionalContent condition="$convertE1">
    <p>Check stability of equilibrium <m>$var(t)=$IC1</m>. 
      <answer name="ansE1">
        <award>
          <when><boolean extend="$E1.stable" /> = $Estable1</when>
        </award>
      </answer>
    </p>
    <feedback updateWith="$ansE1" condition="$ansE1.creditAchieved &lt; 1"> 
      Click the line representing the equilibrium to toggle its stability.  (Solid line corresponds to stable; dashed line corresponds to unstable.)
    </feedback>
  </conditionalContent>


</li>


            
<conditionalContent condition="$numPoints >= 2">

  <li>
  <p>Click <updateValue name="revealSolution2" type="boolean" target="$showSolution2" newValue="true" disabled="$showSolution2">
    <label>show curve</label>
  </updateValue> and use the curve to draw the solution for <m>$ICexpr=$IC2</m>.
